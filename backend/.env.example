# ── Ollama Configuration ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Ollama server (default: local)
OLLAMA_URL=http://localhost:11434

# Ollama model to use — must be pulled first:
#   ollama pull llama3.2       (recommended, ~2GB)
#   ollama pull mistral        (~4GB)
#   ollama pull qwen2.5:3b     (~2GB, lighter)
OLLAMA_MODEL=llama3.2

# Backend server settings
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated origins (use * for development only)
ALLOWED_ORIGINS=*

# SQLite database path (relative to backend/)
DB_PATH=data/tasks.db
