# ── Ollama Configuration ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Ollama server (default: local)
OLLAMA_URL=http://localhost:11434

# Ollama model to use — must be pulled first:
#   ollama pull llama3.2       (recommended, ~2GB)
#   ollama pull mistral        (~4GB)
#   ollama pull qwen2.5:3b     (~2GB, lighter)
OLLAMA_MODEL=llama3.2

# Backend server settings
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated origins (use * for development only)
ALLOWED_ORIGINS=*

# SQLite database path (relative to backend/)
DB_PATH=data/tasks.db

# ── Instant Real Email Delivery Configuration ───────────────────
# For instant inbox delivery (< 2 seconds):
# Option A (Gmail Direct SMTP):
#   1. Set SMTP_USER to your gmail address.
#   2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
#   3. Paste it into SMTP_PASSWORD below.
# Option B (Resend REST API):
#   Get a free API key from https://resend.com and set RESEND_API_KEY below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=syedshahid0711@gmail.com
SMTP_PASSWORD=
RESEND_API_KEY=
