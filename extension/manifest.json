{
  "manifest_version": 3,
  "name": "Privacy Browser Agent",
  "version": "1.0.0",
  "description": "On-device privacy-preserving AI browser agent for SIH26171. Fills forms using local private data, never exposing PII to the server.",

  "icons": {
    "16":  "assets/icons/icon16.png",
    "48":  "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Privacy Browser Agent",
    "default_icon": {
      "16":  "assets/icons/icon16.png",
      "48":  "assets/icons/icon48.png"
    }
  },

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "utils/logger.js",
        "privacy/pii-detector.js",
        "storage/profile-store.js",
        "automation/action-executor.js",
        "automation/direct-filler.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "offscreen"
  ],

  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "<all_urls>"
  ],

  "web_accessible_resources": [
    {
      "resources": ["assets/*", "assets/libs/*", "utils/docx-parser.js", "viewer/*"],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
