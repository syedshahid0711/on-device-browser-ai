# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/settings.json
.idea/
*.swp

# Extension build artifacts (keep source, ignore packed)
extension/*.crx
extension/*.pem

# ONNX / AI model weights (large files — track with Git LFS if needed)
*.onnx
*.bin
models/

# Misc
*.bak
*.tmp
